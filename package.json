{
  "name": "chord-transposer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b --pretty false && vite build",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-chord-sheet-maker",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-chord-sheet-maker \"vitest run --config vitest.emulator.config.ts\"",
    "test:e2e": "playwright test",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 5174 --strictPort",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "rules:deploy:preview": "firebase deploy --only firestore:rules --project preview",
    "rules:deploy:production": "firebase deploy --only firestore:rules --project production",
    "test:e2e:emulator": "firebase emulators:exec --only auth,firestore --project demo-chord-sheet-maker \"playwright test -c playwright.emulator.config.ts\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^13.3.0",
    "firebase-tools": "^15.36.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.8"
  }
}

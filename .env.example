# Firebase web app config. Not secret: the security rules are the protection.
# .env.production and .env.preview hold the real projects; Vercel picks one with `--mode $VERCEL_ENV`.
# Development leaves these unset and uses the emulators (`npm run emulators`).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

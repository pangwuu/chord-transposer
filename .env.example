# Firebase web app config. Not secret: the security rules are the protection.
# Leave these unset for local development, which uses the emulators (`npm run emulators`).
# On Vercel, set all four per environment: the production project for Production, the preview project for Preview.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
